{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    },
    "antico-devtools": {
      "command": "npx",
      "args": [
        "tsx",
        "src/devtools-mcp-server.ts"
      ]
    }
  }
}